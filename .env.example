# Copy to .env next to docker-compose.yml. All values are optional.

# The folder of book packs mounted at /books (read at runtime; restart after changes)
# GAMEBOOK_BOOKS=../my-books

# Where the container's port is published (default 127.0.0.1:3000, behind a reverse proxy)
# GAMEBOOK_BIND=127.0.0.1
# GAMEBOOK_PORT=3000

# Feedback / takedown form linked from the title page and the footer (no link while empty)
# NUXT_PUBLIC_FEEDBACK_URL=https://forms.gle/...

# The engine credited in every imprint and footer (defaults to github.com/valVk/gamebook-engine)
# NUXT_PUBLIC_ENGINE_URL=https://github.com/<you>/<your-fork>
